+	/*
+	 * The firmware-attributes device needs capability data 01. On some
+	 * machines (e.g. Yoga Pro 7 14IAH10/83KF) the CAPABILITY_DATA_01
+	 * WMI block is dropped by the WMI core because its WQB1 query
+	 * method is missing, so cd01_list is never provided. Fan and
+	 * battery support still work; skip only the fw-attributes knobs.
+	 */
+	if (priv->cd01_list)
+		lwmi_om_fw_attr_add(priv);
 
 	return 0;
 }
@@ -1701,6 +1709,8 @@
 	lwmi_cd_match_add_all(&wdev->dev, &master_match);
 	if (IS_ERR(master_match))
 		return PTR_ERR(master_match);
